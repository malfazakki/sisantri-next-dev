model Activity {
  // base
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // attribute
  name String @unique // "Kantor", "Tahajud", "Dhuha"

  // relation
  attendances           Attendance[]
  activityRegistrations ActivityRegistration[]
}
