model Attendance {
  // base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // attribute
  date       DateTime // Tanggal absen (Hanya tanggalnya saja)
  status     String // H, S, I, A
  profileId  String
  activityId Int

  // relation
  profile      Profile              @relation(fields: [profileId], references: [id])
  activity     Activity             @relation(fields: [activityId], references: [id])
  registration ActivityRegistration @relation("ActivityRegistrationToAttendance", fields: [profileId, activityId], references: [profileId, activityId])

  // Mencegah double absen di hari & kegiatan yang sama untuk satu orang
  @@unique([profileId, activityId, date])
}
